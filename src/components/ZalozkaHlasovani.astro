---
import type { HlasovaniPravidla } from '../lib/hlasovani';
import { souhrnKlubu, rozdelKluby, rozpisKlubu, popisekTypu, popisekVysledku, VETA_PROCEDURALNI } from '../lib/hlasovani';
import { datumText } from '../lib/casova-osa';
import '../styles/hlasovani.css';

interface Props { hlasovani: HlasovaniPravidla[] }
const { hlasovani } = Astro.props;
---
<h3 class="panel-nadpis">Hlasování</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
<ol class="hl-seznam">
  {hlasovani.map(h => (
    <li class="hl-blok" data-hlasovani={h.id}>
      <p class="hl-meta">{datumText(h.snimek.datum)} · hlasování č. {h.snimek.cislo} · <span class="hl-typ">{popisekTypu(h.typ)}</span></p>
      <p class="hl-co">{h.co}</p>
      <p class="hl-vysledek"><strong>{popisekVysledku(h.snimek)} {h.snimek.souhrn.pro} : {h.snimek.souhrn.proti}</strong> <span class="hl-legenda">· pro : proti ·</span> <a href={`/hlasovani/${h.id}/`}>Všichni poslanci →</a></p>
      {/* Kluby v řádcích PRO a PROTI podle toho, čeho měly víc: kdo hlasoval s kým, je vidět naráz a slovy.
          Barvy ne — hlas pro není hodnocení (spec hlasování, oddíl 7). Kdo nebyl pro ani proti, má rozpis na stránce hlasování. */}
      <ul class="hl-kluby" aria-label="Jak hlasovaly kluby">
        {Object.entries(rozdelKluby(souhrnKlubu(h.snimek))).filter(([, kluby]) => kluby.length > 0).map(([strana, kluby]) => (
          <li class="hl-strana">
            <span class="hl-strana-nazev" id={`${h.id}-${strana}`}>{strana === 'pro' ? 'Pro' : 'Proti'}</span>
            <ul aria-labelledby={`${h.id}-${strana}`}>
              {kluby.map(k => (
                <li><a href={`/hlasovani/${h.id}/#${k.slug}`}>{k.popisek} <span class="hl-cisla">{k.pro} : {k.proti}</span><span class="jen-ctecka"> ({rozpisKlubu(k)})</span></a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      {h.typ === 'proceduralni' && <p class="hl-proc">{VETA_PROCEDURALNI}</p>}
    </li>
  ))}
</ol>
